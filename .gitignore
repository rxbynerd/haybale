# Build artifacts
/haybale
*.test
*.out

# Coordinator scratch dir — never tracked
.reviews/

# scripts/e2e-github.sh's scratch dir: a minted identity token, the
# generated identities.yaml/policy.yaml/haybale.yaml for that run, and
# haybale's own log — never tracked, and removed by the script itself
# on every exit path regardless. Matched by prefix, not the exact
# `.e2e-github` name: the default scratch dir is now PID-suffixed
# (`.e2e-github.$$`, e.g. `.e2e-github.12345`) so concurrent runs don't
# clobber each other's in-flight files (see HAYBALE_E2E_SCRATCH in
# scripts/e2e-github.sh's header comment).
.e2e-github*/

# Editor/OS cruft
.DS_Store
